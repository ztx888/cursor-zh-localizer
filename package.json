  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ztx888/cursor-zh-localizer.git"
  },
  "bugs": {
    "url": "https://github.com/ztx888/cursor-zh-localizer/issues"
  },
  "homepage": "https://github.com/ztx888/cursor-zh-localizer#readme"
}
