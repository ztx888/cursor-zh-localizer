    "patch:backup": "node patch-cursor-zh.js --backup",
    "check": "node --check patch-cursor-zh.js"
  },
  "keywords": [
    "cursor",
    "localization",
    "chinese",
    "zh-cn",
    "macos",
    "patch"
  ],
